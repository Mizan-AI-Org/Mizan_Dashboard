# Read-only Postgres connection string for the Mizan Command Center.
# Ensure this user has ONLY SELECT privileges on the analytics schema.
#
# Example:
# postgres://readonly_user:strong-password@host:5432/mizan_prod
RDS_READONLY_URL=

# Seconds to cache dashboard metrics before refreshing from Postgres (default: 120).
DASHBOARD_CACHE_TTL_SECONDS=120

# Postgres timeouts (milliseconds).
DASHBOARD_DB_CONNECT_TIMEOUT_MS=30000
DASHBOARD_DB_STATEMENT_TIMEOUT_MS=60000

# Restaurant delete from dashboard (requires writable DB user).
# Uses DATABASE_URL, else RDS_ADMIN_URL, else RDS_READONLY_URL.
DASHBOARD_DELETE_ENABLED=true
# Required in production to authorize DELETE /api/dashboard/restaurants/:id
# DASHBOARD_DELETE_SECRET=your-secret-here

